{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-tray@onur.local",
      "strict_min_version": "128.0"
    }
  },
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.2",
  "icons": {
    "64": "icon.png"
  },
  "permissions": [
    "accountsRead"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "trayhelper": {
      "schema": "experiment.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "trayhelper"
          ]
        ],
        "script": "experiment.js"
      }
    }
  },
  "default_locale": "en"
}
