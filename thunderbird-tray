#!/usr/bin/env python3
"""KDE system tray icon for Thunderbird (Thunderbird has no tray support on Linux).

thunderbird-tray                start the tray icon
thunderbird-tray --hidden       tray + start Thunderbird hidden (session login)
thunderbird-tray --show [arg]   tray + start / raise Thunderbird (menu launcher, mailto: etc.)
thunderbird-tray --quit         quit Thunderbird completely and remove the tray icon

Tray: left click = show / hide the Thunderbird window; right click = New message, Quit.
The icon shows a badge with the number of unseen new mails in the inboxes (1–5, more: 5+).
Texts are Turkish if the system language or region is Turkish, English otherwise
(override: THUNDERBIRD_TRAY_LANG=tr|en).

Parts:
- "Thunderbird tray helper" add-on (repo: addon/, installed into the profile): the X button
  minimizes Thunderbird instead of quitting (taken from "Minimize on Close"); writes the unseen new
  mail count to $XDG_RUNTIME_DIR/thunderbird-tray/unread.
- KWin script thunderbird-tray (~/.local/share/kwin/scripts/thunderbird-tray): hides the minimized
  main window from the taskbar; on --hidden start it asks TakeStartHidden and minimizes the window.
"""
import os
import subprocess
import sys
import tempfile
import threading
import time

import cairo
import gi
gi.require_version("Dbusmenu", "0.4")
from gi.repository import Dbusmenu, Gio, GLib

THUNDERBIRD = "/usr/bin/thunderbird"
BUS_NAME = "org.onur.ThunderbirdTray"
ICON = "org.mozilla.Thunderbird"
ICON_PNG = "/usr/share/icons/hicolor/64x64/apps/org.mozilla.Thunderbird.png"
UNREAD_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "thunderbird-tray", "unread")

# Language: Turkish if the UI language or any regional format (LC_TIME etc.) is Turkish
LOCALE_VARS = ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG", "LC_TIME", "LC_NUMERIC", "LC_MONETARY",
               "LC_PAPER", "LC_MEASUREMENT", "LC_ADDRESS", "LC_TELEPHONE")


def is_turkish():
    forced = os.environ.get("THUNDERBIRD_TRAY_LANG", "").strip().lower()
    if forced:
        return forced.startswith("tr")
    for var in LOCALE_VARS:
        for value in os.environ.get(var, "").split(":"):
            lang, _, region = value.split(".")[0].partition("_")
            if lang.lower() == "tr" or region.upper() == "TR":
                return True
    return False


TEXTS = {
    "en": {
        "show": "Show Thunderbird",
        "compose": "Write new message",
        "quit": "Quit Thunderbird",
        "closed": "Thunderbird is not running — click to start",
        "new": "{} new mail",
        "new_plural": "{} new mails",
        "none": "No new mail",
        "click": "Click: show / hide",
    },
    "tr": {
        "show": "Thunderbird'ü göster",
        "compose": "Yeni mesaj yaz",
        "quit": "Thunderbird'ü tamamen kapat",
        "closed": "Thunderbird kapalı — tıkla: aç",
        "new": "{} yeni mail",
        "new_plural": "{} yeni mail",
        "none": "Yeni mail yok",
        "click": "Tıkla: aç / gizle",
    },
}
T = TEXTS["tr" if is_turkish() else "en"]

# Main window: title "... - Mozilla Thunderbird" (compose window: "... - Thunderbird")
MAIN_JS = """
const mains = workspace.windowList().filter(w =>
    w.resourceClass.toLowerCase().includes("thunderbird") && w.normalWindow
    && w.caption.endsWith("Mozilla Thunderbird"));
"""
# Hide if visible and focused, show otherwise
TOGGLE_JS = MAIN_JS + """
if (mains.some(w => !w.minimized && workspace.activeWindow === w)) {
    mains.forEach(w => { w.minimized = true; });
} else {
    mains.forEach(w => { w.minimized = false; });
    if (mains.length) workspace.activeWindow = mains[0];
}
"""
RAISE_JS = MAIN_JS + """
mains.forEach(w => { w.minimized = false; });
if (mains.length) workspace.activeWindow = mains[0];
"""

TRAY_XML = f"""
<node><interface name="{BUS_NAME}">
  <method name="TakeStartHidden"><arg type="b" direction="out"/></method>
</interface></node>
"""


def run(*cmd):
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def thunderbird_running():
    return run("pgrep", "-x", "thunderbird")


def launch(*args):
    subprocess.Popen([THUNDERBIRD, *args], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kwin(js):
    # On Wayland, a KWin script is the way to raise another application's window
    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
        f.write(js)
    name = f"thunderbird-tray-{os.getpid()}-{time.monotonic_ns()}"
    try:
        sid = subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript",
                              f.name, name], capture_output=True, text=True).stdout.strip()
        run("qdbus6", "org.kde.KWin", f"/Scripting/Script{sid}", "org.kde.kwin.Script.run")
        time.sleep(0.5)  # run() is async; unloading right away removes the script before it runs
        run("qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name)
    finally:
        os.unlink(f.name)


def toggle():
    if not thunderbird_running():
        launch()
    else:
        kwin(TOGGLE_JS)


def show(args=()):
    if not thunderbird_running():
        launch(*args)
        return
    if args:  # pass on to the running Thunderbird (mailto:, -compose ...)
        launch(*args)
    if not args or args[0] not in ("-compose",) and not args[0].startswith("mailto:"):
        kwin(RAISE_JS)


def unread_count():
    """Unseen new mail count written by the add-on; 0 if Thunderbird is not running."""
    if not thunderbird_running():
        return 0
    try:
        return int(open(UNREAD_FILE).read().strip() or 0)
    except (OSError, ValueError):
        return 0


def badge_pixmap(count):
    """Thunderbird icon + red count badge top right, as SNI IconPixmap (ARGB, network byte order)."""
    surface = cairo.ImageSurface.create_from_png(ICON_PNG)
    size = surface.get_width()
    cr = cairo.Context(surface)
    text = str(count) if count <= 5 else "5+"
    r = size * 0.27
    w = r * 2 if len(text) == 1 else r * 2.9
    x, y = size - w, 0
    cr.new_sub_path()
    cr.arc(x + r, y + r, r, 0.5 * 3.14159, 1.5 * 3.14159)
    cr.arc(x + w - r, y + r, r, 1.5 * 3.14159, 0.5 * 3.14159)
    cr.close_path()
    cr.set_source_rgb(0.85, 0.11, 0.14)
    cr.fill_preserve()
    cr.set_source_rgb(1, 1, 1)
    cr.set_line_width(size * 0.04)
    cr.stroke()
    cr.select_font_face("sans-serif", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(r * 1.45)
    ext = cr.text_extents(text)
    cr.move_to(x + w / 2 - ext.width / 2 - ext.x_bearing, y + r - ext.height / 2 - ext.y_bearing)
    cr.show_text(text)
    surface.flush()
    # cairo ARGB32 is B,G,R,A in memory on little-endian machines; SNI wants A,R,G,B
    data = bytearray(surface.get_data())
    data[0::4], data[1::4], data[2::4], data[3::4] = data[3::4], data[2::4], data[1::4], data[0::4]
    return [(size, surface.get_height(), bytes(data))]


def quit_thunderbird():
    # Thunderbird quits cleanly on SIGTERM (closing the window only minimizes it because of the add-on)
    run("pkill", "-TERM", "-x", "thunderbird")


# ---------- KDE tray icon (StatusNotifierItem + dbusmenu) ----------

SNI_XML = """
<node><interface name="org.kde.StatusNotifierItem">
  <property name="Category" type="s" access="read"/>
  <property name="Id" type="s" access="read"/>
  <property name="Title" type="s" access="read"/>
  <property name="Status" type="s" access="read"/>
  <property name="IconName" type="s" access="read"/>
  <property name="IconPixmap" type="a(iiay)" access="read"/>
  <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
  <property name="ItemIsMenu" type="b" access="read"/>
  <property name="Menu" type="o" access="read"/>
  <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
  <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
  <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
  <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
  <signal name="NewIcon"/><signal name="NewToolTip"/><signal name="NewTitle"/><signal name="NewStatus"><arg type="s"/></signal>
</interface></node>
"""


class Tray:
    def __init__(self, start_hidden):
        self.loop = GLib.MainLoop()
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.start_hidden = start_hidden
        self.count = 0
        self.pixmap = []

        root = Dbusmenu.Menuitem.new()
        for label, fn in ((T["show"], lambda: kwin(RAISE_JS) if thunderbird_running() else launch()),
                          (T["compose"], lambda: launch("-compose"))):
            it = self._item(label)
            it.connect("item-activated", lambda *_, f=fn: self.bg(f))
            root.child_append(it)
        sep = Dbusmenu.Menuitem.new()
        sep.property_set(Dbusmenu.MENUITEM_PROP_TYPE, Dbusmenu.CLIENT_TYPES_SEPARATOR)
        root.child_append(sep)
        quit_item = self._item(T["quit"])
        quit_item.connect("item-activated", lambda *_: self.quit())
        root.child_append(quit_item)
        self.menu_server = Dbusmenu.Server.new("/MenuBar")
        self.menu_server.set_root(root)

        node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        self.bus.register_object("/StatusNotifierItem", node.interfaces[0], self._on_call, self._on_prop, None)
        tray_node = Gio.DBusNodeInfo.new_for_xml(TRAY_XML)
        self.bus.register_object("/ThunderbirdTray", tray_node.interfaces[0], self._on_tray_call, None, None)
        Gio.bus_own_name_on_connection(self.bus, BUS_NAME, Gio.BusNameOwnerFlags.NONE, None, None)
        self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE, None, None)
        # register again if plasmashell restarts
        Gio.bus_watch_name_on_connection(self.bus, "org.kde.StatusNotifierWatcher",
                                         Gio.BusNameWatcherFlags.NONE, lambda *_: self._register(), None)

    @staticmethod
    def _item(label):
        it = Dbusmenu.Menuitem.new()
        it.property_set(Dbusmenu.MENUITEM_PROP_LABEL, label)
        return it

    def _register(self):
        self.bus.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                      "RegisterStatusNotifierItem", GLib.Variant("(s)", (self.name,)), None, 0, -1, None, None)

    def _on_prop(self, _c, _s, _p, _i, prop):
        return {
            "Category": GLib.Variant("s", "Communications"),
            "Id": GLib.Variant("s", "thunderbird-tray"),
            "Title": GLib.Variant("s", "Thunderbird"),
            "Status": GLib.Variant("s", "Active"),
            # IconName empty while a badge is shown: Plasma prefers IconName over IconPixmap
            "IconName": GLib.Variant("s", "" if self.count else ICON),
            "IconPixmap": GLib.Variant("a(iiay)", self.pixmap),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (ICON, [], "Thunderbird", self.tooltip())),
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", "/MenuBar"),
        }.get(prop)

    def tooltip(self):
        if not thunderbird_running():
            return T["closed"]
        if self.count:
            unread = (T["new"] if self.count == 1 else T["new_plural"]).format(self.count)
        else:
            unread = T["none"]
        return f"{unread}\n{T['click']}"

    def refresh(self):
        count = unread_count()
        if count != self.count:
            self.count = count
            self.pixmap = badge_pixmap(count) if count else []
            self._emit("NewIcon")
        self._emit("NewToolTip")
        return True

    def _emit(self, signal):
        self.bus.emit_signal(None, "/StatusNotifierItem", "org.kde.StatusNotifierItem", signal, None)

    def _on_call(self, _c, _s, _p, _i, method, _params, invocation):
        if method == "Activate":  # left click
            self.bg(toggle)
        invocation.return_value(None)

    def _on_tray_call(self, _c, _s, _p, _i, method, _params, invocation):
        # The KWin script asks when the main window opens; True only once, on a --hidden start
        hidden, self.start_hidden = self.start_hidden, False
        invocation.return_value(GLib.Variant("(b)", (hidden,)))

    def bg(self, fn, *args):
        threading.Thread(target=fn, args=args, daemon=True).start()

    def quit(self):
        def work():
            quit_thunderbird()
            GLib.idle_add(self.loop.quit)
        self.bg(work)

    def run(self):
        if self.start_hidden:
            if thunderbird_running():
                self.start_hidden = False
            else:
                launch()
                # if no window appeared within 60 s, the next manual start must not be hidden
                GLib.timeout_add_seconds(60, lambda: setattr(self, "start_hidden", False))
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)
        self.loop.run()


def tray(start_hidden=False):
    import fcntl
    # Single instance: a second tray process cannot take the lock and exits (no duplicate icon)
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "thunderbird-tray.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if start_hidden and not thunderbird_running():
            launch()
        return
    Tray(start_hidden).run()


def start_tray():
    subprocess.Popen([os.path.abspath(__file__)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg == "--show":
        start_tray()  # exits right away because of the lock if already running
        show(sys.argv[2:])
    elif arg == "--hidden":
        tray(start_hidden=True)
    elif arg == "--quit":
        quit_thunderbird()
        run("pkill", "-f", r"^\S*python3? \S*/thunderbird-tray( |$)")
    elif arg is None:
        tray()
    else:
        sys.exit(__doc__)
